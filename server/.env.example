# UNMASKED Backend Server Environment Configuration
PORT=5000

# Google Gemini API Key (Dapatkan gratis di https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model yang digunakan (Rekomendasi: gemini-flash-latest atau gemini-3.6-flash)
GEMINI_MODEL=gemini-flash-latest
